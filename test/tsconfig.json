{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": [
      "@cloudflare/workers-types/experimental",
      "@cloudflare/vitest-plugin/types",
      "@types/node",
      "vite/client"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../app/components/product-image-field.tsx",
    "../app/lib/auth/access.ts",
    "../app/lib/bookmarklet.ts",
    "../app/lib/cloudflare/access-membership.ts",
    "../app/lib/db/family-members.ts",
    "../app/lib/db/members.ts",
    "../app/lib/db/product-lookups.ts",
    "../app/lib/db/wishlists.ts",
    "../app/lib/product-image.ts",
    "../app/lib/product-draft.ts",
    "../app/lib/product-metadata.ts",
    "../app/lib/product-url.ts",
    "../app/lib/request-security.ts",
    "../app/lib/security-headers.ts",
    "../app/lib/share-target.ts"
  ]
}
