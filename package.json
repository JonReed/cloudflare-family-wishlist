{
  "name": "cloudflare-family-wishlist",
  "version": "0.1.0",
  "description": "A private, self-hosted family wishlist built for Cloudflare's free tier.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonReed/cloudflare-family-wishlist.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types --check && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "postinstall": "wrangler types && react-router typegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "react-router typegen && eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "jose": "^6.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
