{
  "id": "/",
  "name": "Family Wishlist",
  "short_name": "Wishlist",
  "description": "A private wishlist for your favourite people.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eee3cf",
  "theme_color": "#28503e",
  "icons": [
    {
      "src": "/icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
